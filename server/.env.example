# Змінні середовища серверної частини Session.
# Скопіюйте цей файл у server/.env і підставте значення з кореневого .env.

NODE_ENV=development

# Порт, на якому працює API (клієнт проксіює /api на цей порт)
PORT=3000

# Рядок підключення до PostgreSQL у Docker-контейнері:
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?schema=public
DATABASE_URL=postgresql://session:change_me@localhost:5432/session_db?schema=public

# Секрет для підпису JWT: щонайменше 32 символи, лише у server/.env.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars
# Строк дії токена (за ТЗ – 24 години)
JWT_EXPIRES_IN=24h

# Адреса клієнтської частини, з якої дозволено запити (CORS)
CLIENT_URL=http://localhost:5173

# Окрема тестова БД для npm test (назва має закінчуватися на _test; тести очищають її таблиці).
# Базу в тому самому контейнері PostgreSQL створює Prisma під час першого запуску тестів.
TEST_DATABASE_URL=postgresql://session:change_me@localhost:5432/session_test?schema=public

# Обліковий запис адміністратора, який створює сценарій prisma/seed.js (npm run db:seed).
# Пароль: 8–72 символи, щонайменше одна літера та одна цифра.
ADMIN_EMAIL=admin@session.local
ADMIN_PASSWORD=change_me_123

# Необов'язково: пароль для тестових облікових записів (teacher1/2, student1/2 @session.local).
# Якщо змінна порожня, тестові користувачі та слоти не створюються.
SEED_DEMO_PASSWORD=

# Email-сповіщення (Nodemailer). Якщо SMTP_HOST порожній, листи не надсилаються,
# а їхній текст виводиться в консоль сервера – так прототип перевіряється локально.
# Для локального SMTP-перехоплювача (наприклад, Mailpit): SMTP_HOST=localhost, SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Session <no-reply@session.local>
# Часовий пояс дати й часу консультації в листах
MAIL_TIMEZONE=Europe/Kyiv

# Постачальник академічних даних (розклад, оцінки, заборгованості). У прототипі допустимо лише mock:
# демонстраційні дані з server/src/academic/mock/fixtures, без підключення до систем університету.
ACADEMIC_PROVIDER=mock

# Як часто перевіряти нагадування про підтверджені консультації (~за 24 год до початку), node-cron
REMINDER_CRON=*/15 * * * *
