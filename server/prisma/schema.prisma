// Схема бази даних Session (Prisma ORM, PostgreSQL), ТЗ розділ 9.4.
// Частковий унікальний індекс "Booking_active_slot_unique" засобами Prisma не описується:
// він створюється SQL-командою в міграції init. Перед застосуванням кожної нової міграції
// перевіряйте, що вона його не видаляє (npm run db:check-migrations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SlotStatus {
  FREE
  BOOKED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id              Int                  @id @default(autoincrement())
  // Зберігається в нижньому регістрі (BR-01)
  email           String               @unique
  passwordHash    String
  fullName        String
  role            Role
  department      String?
  studentGroup    String?
  slots           Slot[]               @relation("TeacherSlots")
  bookings        Booking[]            @relation("StudentBookings")
  // Академічна інтеграція (ТЗ п. 4.1.5): дисципліни викладача і зіставлення з джерелом даних
  subjects        TeacherSubject[]
  academicMapping AcademicDataMapping?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Slot {
  id        Int        @id @default(autoincrement())
  // Restrict: викладача, який має слоти, видалити не можна (BR-06)
  teacher   User       @relation("TeacherSlots", fields: [teacherId], references: [id], onDelete: Restrict)
  teacherId Int
  startAt   DateTime
  endAt     DateTime
  location  String?
  status    SlotStatus @default(FREE)
  bookings  Booking[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([teacherId, startAt])
}

model Booking {
  id             Int           @id @default(autoincrement())
  // Restrict: слот із записами не видаляється, а переводиться в CANCELLED (9.2)
  slot           Slot          @relation(fields: [slotId], references: [id], onDelete: Restrict)
  slotId         Int
  // Restrict: студента, який має записи, видалити не можна (BR-06)
  student        User          @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Restrict)
  studentId      Int
  // Дисципліна, з якої запитано консультацію (FR-33, необов'язкова)
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  subjectId      Int?
  topic          String
  status         BookingStatus @default(PENDING)
  reminderSentAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([studentId])
  @@index([slotId])
}

// ---------------------------------------------------------------------------
// Академічна інтеграція (ТЗ п. 4.1.5, таблиці 4.5, 4.7). Оцінки, заборгованості, профіль
// і розклад студента в БД не зберігаються: їх повертає постачальник академічних даних.
// Таблиці нижче заповнює лише сценарій початкового заповнення (prisma/seed.js).

// Довідник дисциплін Session; externalId – код дисципліни в джерелі академічних даних
model Subject {
  id         Int              @id @default(autoincrement())
  externalId String           @unique
  name       String
  teachers   TeacherSubject[]
  bookings   Booking[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

// Зв'язок викладач – дисципліна (FR-32)
model TeacherSubject {
  teacher   User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId Int

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

// Зіставлення облікового запису Session з профілем у джерелі академічних даних (FR-27).
// Користувач не може вказати чи змінити externalId: запис створює лише seed.
model AcademicDataMapping {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int      @unique
  provider   String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
}
